@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(sqlite3 CONFIG)

if(NOT @QUIVER_BUILD_SHARED@)
    find_dependency(spdlog CONFIG)
    find_dependency(OpenXLSX CONFIG)
    find_dependency(Arrow 25.0.1 CONFIG)
    find_dependency(Parquet 25.0.1 CONFIG)
    # lua-cmake installs its exported targets directly in lib/cmake.
    if(NOT TARGET CMath::CMath)
        add_library(CMath::CMath INTERFACE IMPORTED)
        if(UNIX)
            set_property(TARGET CMath::CMath PROPERTY INTERFACE_LINK_LIBRARIES m)
        endif()
    endif()
    if(NOT TARGET lua_library)
        include("${CMAKE_CURRENT_LIST_DIR}/../Lua.cmake")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/quiverTargets.cmake")

check_required_components(quiver)
