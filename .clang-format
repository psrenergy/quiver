BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
LineEnding: LF
InsertNewlineAtEOF: true
ColumnLimit: 120
IndentWidth: 4
TabWidth: 4
AccessModifierOffset: -4

# BlockIndent everywhere: clang-format 22 spells `AlignAfterOpenBracket: BlockIndent` as the
# BracedList/Function/If pairs; Loop/Switch extend it to loop and switch headers. 22-only keys.
BreakAfterOpenBracketBracedList: true
BreakAfterOpenBracketFunction: true
BreakAfterOpenBracketIf: true
BreakAfterOpenBracketLoop: true
BreakAfterOpenBracketSwitch: true
BreakBeforeCloseBracketBracedList: true
BreakBeforeCloseBracketFunction: true
BreakBeforeCloseBracketIf: true
BreakBeforeCloseBracketLoop: true
BreakBeforeCloseBracketSwitch: true
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BinPackArguments: false
BinPackParameters: OnePerLine
PenaltyReturnTypeOnItsOwnLine: 1000
# Without these, `QUIVER_C_API quiver_error_t name(` is not recognized as a declaration and the
# penalty above never applies to it.
TypeNames: [quiver_error_t, int64_t]
PackConstructorInitializers: NextLine

AllowShortFunctionsOnASingleLine: Empty
InsertBraces: true
BreakTemplateDeclarations: Yes
KeepEmptyLines:
  AtStartOfBlock: false
WrapNamespaceBodyWithEmptyLines: Always
AlignEscapedNewlines: Left
PointerAlignment: Left
SpacesBeforeTrailingComments: 2
SpacesInContainerLiterals: false

# Main header, then project "...", then third-party <lib/...>, then std <bare>.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<[a-z_0-9]+>$'
    Priority: 3
  - Regex: '^<'
    Priority: 2
